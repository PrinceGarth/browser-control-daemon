{
  "name": "browser-control-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Shared daemon + thin MCP shim for the Browser Control extension, supporting many concurrent Claude Code sessions on one port",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "browser-control-mcp": "dist/server.js",
    "browser-control-daemon": "dist/daemon.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "daemon": "node dist/daemon.js",
    "test": "npm run build && node --test dist/test/e2e.test.js",
    "stop": "node dist/stop.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "dayjs": "^1.11.13",
    "ws": "^8.18.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.2"
  }
}